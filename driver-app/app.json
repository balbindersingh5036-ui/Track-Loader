{
  "expo": {
    "name": "LoadBalbin Driver & Agency",
    "slug": "loadbalbin-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#08111F"
    },
    "ios": {
      "supportsTablet": true,
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#08111F"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LoadBalbin to select a profile photo.",
          "cameraPermission": "Allow LoadBalbin to take a profile photo.",
          "microphonePermission": false
        }
      ]
    ],
    "android": {
      "package": "com.loadbalbin.driver",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08111F"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#08111F"
      },
      "permissions": []
    }
  }
}
