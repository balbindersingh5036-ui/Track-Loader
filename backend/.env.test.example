# Copy to .env.test and replace every placeholder with test-only values.
# Use a separate local/test MongoDB database; never use the production URI.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/loadbalbin_test
TEST_JWT_SECRET=replace-with-a-random-test-only-secret

TEST_ADMIN_EMAIL=admin@example.invalid
TEST_ADMIN_PASSWORD=replace-with-a-test-only-password
TEST_CUSTOMER_EMAIL=customer@example.invalid
TEST_CUSTOMER_PASSWORD=replace-with-a-test-only-password
TEST_DRIVER_EMAIL=driver@example.invalid
TEST_DRIVER_PASSWORD=replace-with-a-test-only-password
